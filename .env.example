# Copy this file to `.env` and adjust. `.env` is git-ignored.
DATABASE_URL=sqlite://db.sqlite?mode=rwc
HOST=127.0.0.1
PORT=3000
# Apply pending migrations when the server starts (set to false in prod if you
# prefer running `cargo run -p migration -- up` as a separate deploy step).
RUN_MIGRATIONS=true
# Log levels, see https://docs.rs/tracing-subscriber (EnvFilter)
RUST_LOG=axum_project=debug,tower_http=debug,sea_orm=info
